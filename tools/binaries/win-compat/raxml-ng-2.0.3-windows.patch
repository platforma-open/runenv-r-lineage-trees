+  u.LowPart = t.dwLowDateTime;
+  u.HighPart = t.dwHighDateTime;
+  return u.QuadPart * 1.0e-7;
+}
+
+static unsigned long peak_working_set()
+{
+  PROCESS_MEMORY_COUNTERS pmc;
+  if (!GetProcessMemoryInfo(GetCurrentProcess(), &pmc, sizeof(pmc)))
+    return 0;
+  return (unsigned long)pmc.PeakWorkingSetSize;
+}
+
+void sysutil_show_rusage()
+{
+  FILETIME created, exited, kernel, user;
+  GetProcessTimes(GetCurrentProcess(), &created, &exited, &kernel, &user);
+  fprintf(stderr, "Time: %.3fs (user)", filetime_seconds(user));
+  fprintf(stderr, " %.3fs (sys)", filetime_seconds(kernel));
+  fprintf(stderr, " Memory: %.0fMB\n", peak_working_set() * 1.0e-6);
+}
+
+unsigned long sysutil_get_memused()
+{
+  return peak_working_set();
